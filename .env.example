# =============================================================================
# University Academic AI Assistant - Environment Configuration
# =============================================================================

# Server Settings
PORT=8080
NODE_ENV=development

# MySQL 8 Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=academic_ai_db
DB_USER=root
DB_PASSWORD=root

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# Spring AI & LLM Provider Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.2

# Stateless JWT Security
JWT_SECRET=universityAcademicAssistantSecretKeyWithAtLeast256BitsLengthForHS256Security2026
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# RAG Hyperparameters
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.70
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

# File Upload Directory
UPLOAD_DIR=./uploads
